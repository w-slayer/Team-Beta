\f1\b0 \cf2 \
getAverageRating()\
\
    reviews = fetch all Reviews where gameID = this.gameID\
\
    IF reviews is empty -> RETURN 0.0\
\
\
    sum = 0\
\
    FOR each review in reviews\
\
        sum = sum + review.rating\
\
\
    RETURN sum / count(reviews)\
\
\
getReviews()\
\
    reviews = query database for Reviews where gameID = this.gameID\
\
    RETURN reviews\
\
\
getForumPosts()\
\
    posts = query database for ForumPosts where gameID = this.gameID\
\
    RETURN posts\
\
\
update(title, developer)\
\
    IF title is empty -> throw error\
\
    IF developer is empty -> throw error\
\
\
    this.title     = title\
\
    this.developer = developer\
\
    save changes to database\
\
    RETURN\
\
\
deleteGame()\
\
    delete all Reviews for this gameID\
\
    delete all ForumPosts for this gameID\
