\
    IF this.platformUsername is empty -> throw error\
\
\
    rawAchievements = call platform API to fetch achievements for platformUsername\
\
    IF API call fails -> throw error\
\
\
    FOR each achievement in rawAchievements\
\
        IF achievement not already in local database\
\
            create new Achievement record\
\
            save to database\
\
\
    RETURN Achievement[]\
\
