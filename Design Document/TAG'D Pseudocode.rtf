\
    VALIDATE email is valid format\
\
    VALIDATE password length >= 8\
\
\
    userID        = new auto-generated int\
\
    this.username = username\
\
    this.email    = email\
\
    this.password = hashPassword(password)\
\
    profileDesc   = ""\
\
    isPublic      = true\
\
\
login(email, password)\
\
    IF email is empty OR password is empty -> throw error\
\
\
    user = look up user by email\
\
    IF user not found -> return false\
\
    IF hashPassword(password) does not match stored hash -> return false\
\
\
    create session token for user\
\
    RETURN true\
\
\
logout()\
\
    IF no active session -> return\
\
    invalidate current session token\
\
    clear session data\
\
    RETURN\
